{
  "_note": [
    "motion_response.py 専用。Slime だけを常時表示し、音なし対照が成立する形。",
    "本番のマルチライフ (vj_asharp_life_540.json) の Slime パラメータと同一。"
  ],
  "seed": 20260710,
  "resolution": [
    960,
    540
  ],
  "modules": [
    {
      "type": "Lenia",
      "name": "lenia0",
      "enabled": true,
      "params": {
        "simWidth": 256,
        "simHeight": 144,
        "radius": 7,
        "dt": 0.18,
        "growthMu": 0.15,
        "growthSigma": 0.016,
        "kernelShellMu": 0.5,
        "kernelShellSigma": 0.15,
        "initCoverage": 0.34,
        "initScale": 7.0,
        "noiseAmount": 0.0,
        "muJitter": 0.0,
        "injectAmount": 0.0,
        "injectCount": 5,
        "blend": "add",
        "opacity": 0.0,
        "colorMap": {
          "palette": "mono",
          "channel": 0,
          "inputScale": 1.0
        }
      }
    },
    {
      "type": "SlimeMold",
      "name": "slime0",
      "enabled": true,
      "params": {
        "agentCount": 130000,
        "moveSpeed": 12,
        "sensorAngle": 0.35,
        "sensorDistance": 5,
        "turnSpeed": 9,
        "depositAmount": 0.1,
        "decayRate": 5.2,
        "diffuseRate": 0.1,
        "jitter": 0.15,
        "attractorWeight": 1.15,
        "spawnMode": 0,
        "showAgents": 0,
        "blend": "add",
        "opacity": 1.0,
        "colorMap": {
          "palette": "mono",
          "channel": 0,
          "inputScale": 0.75
        }
      }
    }
  ],
  "connections": [
    {
      "from": "lenia0.field",
      "to": "slime0.attractorField",
      "mode": "sample"
    }
  ],
  "audioMappings": [
    {
      "_": "Slime — 新生と死",
      "source": "beat.trigger",
      "target": "slime0.resetPulse",
      "scale": 0.7,
      "smoothing": 0.02
    },
    {
      "_": "Slime — 震え",
      "source": "hihat",
      "target": "slime0.jitter",
      "scale": 1.6,
      "smoothing": 0.05
    },
    {
      "_": "Slime — 分岐角",
      "source": "centroid",
      "target": "slime0.sensorAngle",
      "scale": 1.1,
      "smoothing": 0.3
    },
    {
      "_": "Slime — 成長速度",
      "source": "rms",
      "target": "slime0.moveSpeed",
      "scale": 35.0,
      "smoothing": 0.18
    },
    {
      "_": "ParticleLife — 拍で種族が入れ替わる",
      "source": "beat.trigger",
      "target": "pl0.shufflePulse",
      "scale": 0.5,
      "smoothing": 0.02
    },
    {
      "_": "ParticleLife — 力の強さ",
      "source": "rms",
      "target": "pl0.forceBoost",
      "scale": 1.4,
      "smoothing": 0.15
    },
    {
      "_": "ParticleLife — 相互作用の形",
      "source": "centroid",
      "target": "pl0.beta",
      "scale": 0.35,
      "smoothing": 0.4
    },
    {
      "_": "ParticleLife — 震え",
      "source": "hihat",
      "target": "pl0.jitter",
      "scale": 22.0,
      "smoothing": 0.05
    },
    {
      "_": "CA — kick で細胞が生まれる",
      "source": "kick.trigger",
      "target": "ca0.injectAmount",
      "scale": 0.35,
      "smoothing": 0.02
    },
    {
      "_": "orbium — kick で質量注入",
      "source": "kick.trigger",
      "target": "lenia1.injectAmount",
      "scale": 0.25,
      "smoothing": 0.02
    }
  ],
  "musicMappings": [
    {
      "_": "— 生命体のルール —",
      "source": "rms",
      "target": "lenia0.dt",
      "scale": 0.55,
      "smoothing": 0.12
    },
    {
      "source": "kick.trigger",
      "target": "lenia0.injectAmount",
      "scale": 0.3
    },
    {
      "source": "lane.tension",
      "target": "lenia0.muJitter",
      "scale": 0.03,
      "smoothing": 0.8
    },
    {
      "_": "セクションのエネルギーが Lenia の相そのものを決める",
      "source": "section.energy",
      "target": "lenia0.growthMu",
      "scale": 0.035,
      "offset": 0.13,
      "mode": "set",
      "smoothing": 1.2
    },
    {
      "source": "section.is:coda",
      "target": "lenia0.dt",
      "scale": 0.06,
      "smoothing": 2.0
    },
    {
      "_": "走性の強さ。明るさの漏れを抑える要でもある",
      "source": "lane.tension",
      "target": "slime0.attractorWeight",
      "scale": 0.9,
      "offset": 0.6,
      "mode": "set",
      "smoothing": 1.0
    },
    {
      "_": "granular_freeze で場を止める",
      "source": "event:granular_freeze.active",
      "target": "lenia0.freeze",
      "scale": 1.0
    },
    {
      "source": "event:granular_freeze.active",
      "target": "slime0.freeze",
      "scale": 1.0
    },
    {
      "_": "reverse_swell で生命を生み直す（3回）",
      "source": "event:reverse_swell.started",
      "target": "lenia0.reseed",
      "scale": 1.0
    },
    {
      "_": "warp_filter のカットオフはそのイベントが鳴っている間だけ視野を変える",
      "source": "event:warp_filter.cutoff_hz",
      "target": "slime0.sensorDistance",
      "inMin": 200.0,
      "inMax": 8000.0,
      "scale": 3.0,
      "offset": 2.5,
      "mode": "set",
      "smoothing": 0.25
    },
    {
      "source": "lane.spatial_active",
      "target": "slime0.turnSpeed",
      "scale": 6.0,
      "smoothing": 0.4
    }
  ]
}
